# Copy to .env and fill in. Never commit the real .env.

# Generate a real key for anything but throwaway local dev, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=insecure-dev-key-change-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. In docker-compose the host is the service name "db".
DATABASE_URL=postgres://coach:coach@db:5432/coach

# CORS (dev): allow any origin so a local frontend can call the API.
CORS_ALLOW_ALL_ORIGINS=True

# DRF throttle rates (DRF "<num>/<period>" format). Optional — these defaults
# apply if unset. "auth" is the strict scope on login/register (brute-force).
# THROTTLE_ANON=30/min
# THROTTLE_USER=120/min
# THROTTLE_AUTH=10/min

# --- prod-only (ignored in dev) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True
